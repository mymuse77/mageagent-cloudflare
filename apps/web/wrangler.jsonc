{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "madeagent-web",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "madeagent.cc",
      "custom_domain": true
    },
    {
      "pattern": "www.madeagent.cc",
      "custom_domain": true
    }
  ]
}
